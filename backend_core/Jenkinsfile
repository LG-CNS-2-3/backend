pipeline {
    agent any

    tools{
        gradle 'gradle'
        jdk 'openJDK17'
    }

    environment{
        DOCKER_USERNAME = "khw73850"
        EC2_HOST = "ubuntu@10.0.0.24" // backend-core 서버 IP
    }

    stages{
        stage('Checkout') {
            steps {
                echo "Checking out source..."
                checkout scm
            }
        }

        // ====================  backend-core 파이프라인 ====================
        stage('Build and Deploy backend-core') {
            // backend_core 폴더가 변경되거나, develop 브랜치일 때만 실행
            when {
                anyOf {
                    changeset "backend_core/**"
                    branch 'develop'
                }
            }
  
            stages {
                stage('core: Build'){
                    steps{
                        echo "==================== Building backend-core ===================="
                        dir('backend_core'){
                            sh '''
                                chmod +x gradlew
                                ./gradlew build -x test
                            '''
                        }
                    }
                }
                stage('core: Docker Build and Push'){
                    steps{
                        echo "==================== Building & Pushing Docker Image(backend_core) ===================="
                        script{
                            withCredentials([usernamePassword(
                                credentialsId: 'DOCKERHUB_PASSWORD',
                                usernameVariable: 'DOCKER_USER',
                                passwordVariable: 'DOCKER_PASS'
                            )]){
                                sh """
                                   docker build -t ${DOCKER_USER}/backend-core:${currentBuild.number} ./backend_core
                                   docker tag ${DOCKER_USER}/backend-core:${currentBuild.number} ${DOCKER_USER}/backend-core:latest
                                   echo ${DOCKER_PASS} | docker login -u ${DOCKER_USER} --password-stdin
                                   docker push ${DOCKER_USER}/backend-core:${currentBuild.number}
                                   docker push ${DOCKER_USER}/backend-core:latest
                                   docker logout
                                """
                            }
                        }
                    }
                }
                
                // ==================== [오류 수정] 중첩된 블록 및 여분 괄호 제거 ====================
                stage('Deploy to EC2') {
                    steps {
                        echo "Deploying backend-core to EC2 using docker-compose via Bastion..."
                        sshagent(credentials: ['EC2_SSH_CREDENTIALS']) {
                            withCredentials([
                                // 3. .env 파일로 생성할 Credential 목록
                                string(credentialsId: 'EUREKA_SERVICE_URL', variable: 'EUREKA_SERVICE_URL'),
                                string(credentialsId: 'GATEWAY_URL', variable: 'GATEWAY_URL'),
                            ]) {
                                sh """
                                    # 5. Bastion Host 경유를 위해 -J 옵션 추가
                                    ssh -o StrictHostKeyChecking=no ${EC2_HOST} '''

                                        # 6. Jenkins Credential로 .env 파일 동적 생성
                                        echo "Creating .env file..."
                                        cat << 'EOF' > .env
                                        EUREKA_SERVICE_URL=${EUREKA_SERVICE_URL}
                                        GATEWAY_URL=${GATEWAY_URL}
                                        'EOF'

                                        # 7. 동적 IP 주소 가져오기
                                        echo "Fetching EC2 private IP..."
                                        export HOST_IP=\$(TOKEN=\$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
                                            -H "X-aws-ec2-metadata-token-ttl-seconds: 21600") && \
                                            curl -s -H "X-aws-ec2-metadata-token: \$TOKEN" \
                                            http://169.254.169.254/latest/meta-data/local-ipv4)

                                        # 8. 새 이미지 pull
                                        echo "Pulling latest Docker image (backend-core)..."
                                        docker pull ${DOCKER_USERNAME}/backend-core:latest

                                        # 9. 컨테이너 재시작
                                        echo "Running docker-compose up (backend-core)..."
                                        docker-compose up -d

                                        docker image prune -f
                                    '''
                                """
                            }
                        }
                    }
                }
                // =========================================================================
            }
        } // ==================== End of backend-core ====================
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Pipeline completed successfully!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}